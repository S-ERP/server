# ========================================
# Configuración para Deploy de Alvaro
# ========================================

# Host SSH para conectarse al servidor (usuario@ip)
SSH_HOST="servisofts@192.168.2.5"

# Directorio remoto donde está el servidor
REMOTE_DIR="/home/servisofts/servicios/serp/entornos/serp/servicios/serp"

# Directorio de scripts en producción
SCRIPTS_DIR="/home/servisofts/servicios/serp/scripts"

# Directorio de backups en producción
BACKUPS_DIR="/home/servisofts/servicios/serp/backups"

# Directorio remoto para config.json (normalmente igual a REMOTE_DIR)
REMOTE_DIR_CONFIG="/home/servisofts/servicios/serp/entornos/serp/servicios/serp"

# Puerto del servicio
PUERTO=10041

# Contraseña de sudo
SUDO_PASS="servisofts"
